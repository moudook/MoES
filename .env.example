# Copy to .env when available. The app runs fully with defaults (no key needed).

PORT=3000
HOST=0.0.0.0
DEFAULT_PLACE=New Delhi, India
COUNTRY_BIAS=IN

# Free weather data (no key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Gemini API (free tier, https://aistudio.google.com/apikey) — optional,
# deterministic engine answers when this is absent or fails
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
